# Infrastructure configuration -- see docs/specs/Deployment/Environment-Config.md
# Copy to .env for local development. Never commit a real .env file.

ENVIRONMENT=development
LOG_LEVEL=debug

JWT_SIGNING_KEY=dev-only-insecure-key-change-me
JWT_EXPIRY_SECONDS=3600
API_RATE_LIMIT_PER_MINUTE=60

PRIMARY_DB_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_calling_agent
PRIMARY_DB_POOL_SIZE=5

# --- Queue / dialer (Checkpoint 03) ---
REDIS_URL=redis://localhost:6379/0
QUEUE_STREAM_KEY=calls:outbound
QUEUE_CONSUMER_GROUP=dialer-workers
QUEUE_RECLAIM_IDLE_MS=30000

# "mock" is the only supported value until real provider credentials
# exist -- see docs/CHECKPOINT-03-NOTES.md
TELEPHONY_PROVIDER=mock
TELEPHONY_WEBHOOK_SECRET=dev-only-insecure-webhook-secret-change-me

GLOBAL_CPS_LIMIT=20
CAMPAIGN_CPS_LIMIT=5
PROVIDER_CPS_LIMIT=20
GLOBAL_CONCURRENCY_LIMIT=100
CAMPAIGN_CONCURRENCY_LIMIT=30
PROVIDER_CONCURRENCY_LIMIT=100

CIRCUIT_BREAKER_ERROR_THRESHOLD=5
CIRCUIT_BREAKER_OPEN_SECONDS=30

# --- Real-time AI conversation (Checkpoint 04) ---
# "mock" is the only supported value for each until real provider
# credentials exist -- see docs/CHECKPOINT-04-NOTES.md
STT_PROVIDER=mock
LLM_PROVIDER=mock
TTS_PROVIDER=mock
AUDIO_GATEWAY_PROVIDER=mock

# --- Post-call intelligence (Checkpoint 06) ---
# "mock" is the only supported value until real credentials exist --
# see docs/CHECKPOINT-06-NOTES.md
ANALYSIS_LLM_PROVIDER=mock
ANALYSIS_STREAM_KEY=analysis:jobs
ANALYSIS_CONSUMER_GROUP=analysis-workers
ANALYSIS_RECLAIM_IDLE_MS=60000
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_PROMPT_VERSION=POST_CALL_ANALYSIS_V1
ANALYSIS_VERSION=v1
ANALYSIS_MAX_TRANSCRIPT_MESSAGES=200

# --- Dograh integration (Checkpoint 08) ---
# "native" (default) is the existing Checkpoint 03/04 path above.
# "dograh" delegates telephony/STT/LLM/TTS to a separately-run Dograh
# instance -- see docs/CHECKPOINT-08-NOTES.md for the manual Dograh-
# side setup this also requires (a published workflow with an API
# Trigger node and a Webhook node).
CALLING_ENGINE=native
DOGRAH_API_BASE_URL=http://localhost:8080
DOGRAH_API_KEY=
DOGRAH_TRIGGER_UUID=
DOGRAH_TRIGGER_MODE=test
DOGRAH_REQUEST_TIMEOUT_SECONDS=15
DOGRAH_WEBHOOK_SECRET=dev-only-insecure-dograh-webhook-secret-change-me

# --- Production hardening (Checkpoint 09) ---
# With ENVIRONMENT=production the app and workers refuse to start unless
# every secret is set to a non-default value, DOGRAH_TRIGGER_MODE=production
# and DOGRAH_WORKFLOW_ID is set. See docs/CHECKPOINT-09-NOTES.md.
DOGRAH_CONNECT_TIMEOUT_SECONDS=5.0
# Dograh's integer workflow id; required to reconcile ambiguous/lost calls.
DOGRAH_WORKFLOW_ID=
DOGRAH_RECONCILE_AFTER_SECONDS=120
DOGRAH_STALE_ATTEMPT_SECONDS=3600
# Comma-separated JSON list, e.g. ["minio"], for self-hosted transcript storage.
DOGRAH_TRANSCRIPT_ALLOWED_HOSTS=[]
QUEUE_MAX_DELIVERIES=5
QUEUE_DLQ_STREAM_KEY=calls:dlq
CIRCUIT_BREAKER_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_PER_MINUTE=10
WEBHOOK_RATE_LIMIT_PER_MINUTE=600
