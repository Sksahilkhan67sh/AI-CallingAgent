# Infrastructure configuration -- see docs/specs/Deployment/Environment-Config.md
# Copy to .env for local development. Never commit a real .env file.

ENVIRONMENT=development
LOG_LEVEL=debug

JWT_SIGNING_KEY=dev-only-insecure-key-change-me
JWT_EXPIRY_SECONDS=3600
API_RATE_LIMIT_PER_MINUTE=60

PRIMARY_DB_URL=postgresql://postgres:postgres@localhost:5432/ai_calling_agent
PRIMARY_DB_POOL_SIZE=5
