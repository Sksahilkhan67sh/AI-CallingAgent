# Copy to /etc/ai-calling-agent/backup.env (owner postgres:postgres, mode 0600) for
# archive_command, and to the backup job's environment. NO SECRETS BELONG IN THIS FILE:
# the age PRIVATE key never lives on a backup host; passwords come from PGPASSFILE.

# production (default) refuses unencrypted output; "development" is for throwaway drills only.
BACKUP_ENV=production

# --- Postgres connection (values here are non-secret; the password is in PGPASSFILE) ---
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=backup
PGDATABASE=ai_calling_agent
PGPASSFILE=/etc/ai-calling-agent/pgpass

# --- Destination: a DIFFERENT failure domain from the database host (mounted path) ---
BACKUP_DEST=/mnt/backups/ai-calling-agent
WAL_ARCHIVE_DIR=/mnt/backups/ai-calling-agent/wal
# Optional private scratch (tmpfs / encrypted volume) used while verifying / staging.
# BACKUP_STAGING_DIR=/run/backup-staging
# Optional executable called as: CMD ARTIFACT MANIFEST (e.g. to copy to object storage).
# BACKUP_UPLOAD_CMD=/opt/ops/upload_to_bucket.sh

# --- Encryption: PUBLIC key(s) only. Two recipients (two custodians) are recommended. ---
BACKUP_AGE_RECIPIENT=age1replace_with_custodian_a_public_key,age1replace_with_custodian_b_public_key
# BACKUP_ENCRYPTION_TOOL=age        # or gpg (then set BACKUP_GPG_RECIPIENT instead)

# --- Policy (defaults shown) ---
# KEEP_NEWEST=3 KEEP_DAILY=7 KEEP_WEEKLY=4 KEEP_MONTHLY=12
# LOGICAL_WARN_HOURS=26 LOGICAL_CRIT_HOURS=50 BASE_WARN_HOURS=200 BASE_CRIT_HOURS=380
# WAL_WARN_MINUTES=15 WAL_CRIT_MINUTES=30

# --- Restore hosts only (never on the backup host): path to the PRIVATE key FILE ---
# BACKUP_AGE_IDENTITY_FILE=/secure/custodian-a.key
