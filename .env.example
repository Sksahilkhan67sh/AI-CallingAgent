
# --- CP14: compliance basics (phone normalization, calling window, retry defaults) ---
# NOT legal advice. The windows below are conservative defaults pending the owner's legal
# review (see docs/CHECKPOINT-14-NOTES.md). Single-tenant: one default for the whole system.
# Numbers written without a country code are read in the campaign's region (default below).
DEFAULT_REGION=IN
# IANA zone a new campaign's calling window is read in. A zone that cannot load is a BOOT
# ERROR (never a silent UTC fallback) -- requires tzdata in the image.
DEFAULT_TIMEZONE=Asia/Kolkata
# Dialing is only allowed to these regions (JSON list of ISO 3166-1 alpha-2 codes);
# protects against accidental international dialing. DEFAULT_REGION must be in the list.
ALLOWED_DIAL_REGIONS=["IN"]
# Compliance backstop: no campaign window may extend beyond this, in the campaign's own
# timezone (rejected on save AND clamped at dial time). HH:MM[:SS].
HARD_CALLING_WINDOW_START=09:00
HARD_CALLING_WINDOW_END=21:00
# Window of a new campaign's retry policy, and of a legacy campaign that has no policy row.
DEFAULT_CALLING_WINDOW_START=09:00
DEFAULT_CALLING_WINDOW_END=21:00
# Retry defaults (PRODUCT DECISIONS): retries after the first attempt, and the delay before
# each one (JSON list, exactly DEFAULT_MAX_RETRIES entries, each within the backoff bounds).
DEFAULT_MAX_RETRIES=2
DEFAULT_RETRY_SPACING_SECONDS=[3600, 14400]
# Bounds the admin retry-policy API enforces.
MAX_RETRIES_CEILING=5
MIN_RETRY_BACKOFF_SECONDS=300
MAX_RETRY_BACKOFF_SECONDS=604800

# --- CP14: daily spend cap (ESTIMATES, not billing; the provider-side limit in Dograh is the
# real backstop). Counted from PostgreSQL; fails closed if it cannot be computed. ---
# Max calls placed per budget day. 0 blocks ALL dialing. Default is deliberately low:
# raise it consciously for a real campaign.
DAILY_DIAL_CAP=1000
# Optional estimated-spend cap. Set BOTH or NEITHER (one without the other is a startup error).
# DAILY_ESTIMATED_SPEND_CAP=500.0
# ESTIMATED_COST_PER_MINUTE=1.5
# Attempts with no recorded call duration count as this many minutes in the estimate.
ESTIMATED_MINUTES_PER_UNKNOWN_ATTEMPT=1.0
# The budget day is this timezone's calendar day; dialing resumes by itself at its midnight.
BUDGET_TIMEZONE=Asia/Kolkata
# In-process cache of the budget check. The cap is NOT exact: it can be overshot by the
# dials started within one TTL (<= global CPS limit x TTL) plus the dials in flight at once.
BUDGET_CHECK_CACHE_TTL_SECONDS=2
